digraph span_compact {
  rankdir=BT;
  graph [bgcolor="white", pad=0.2, nodesep=0.45, ranksep=0.65];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin=0.12, color="#666666"];
  edge [color="#666666", arrowsize=0.8];
  "def:marker-family-axioms" [label="(1) Desired marker gene properties", fillcolor="#90CAF9"];
  "thm:marker-axiom-representation" [label="(2) The axioms force the intersection rule", fillcolor="#66BB6A"];
  "def:comparison-family-marker" [label="(3) Marker against a set of groups", fillcolor="#90CAF9"];
  "thm:pairwise-recurrence-marker" [label="(4) Pairwise recurrence defines a marker", fillcolor="#66BB6A"];
  "cor:pairwise-reporting-reusable" [label="(5) Pairwise reporting is reusable", fillcolor="#BEE3BF"];
  "prop:cell-type-marker-recurrence" [label="(6) Cell type markers recur across local instances", fillcolor="#A5D6A7"];
  "prop:comparison-family-monotonicity" [label="(7) Restriction to a local comparison set", fillcolor="#A5D6A7"];
  "prop:type-state-scope-inclusion" [label="(8) Type-scope markers restrict to state scope", fillcolor="#A5D6A7"];
  "prop:hierarchical-marker-inclusion" [label="(9) Hierarchical marker inclusion", fillcolor="#A5D6A7"];
  "prop:one-vs-background-decomposition" [label="(10) One-vs-background decomposition", fillcolor="#A5D6A7"];
  "prop:pair-coverage-aggregation" [label="(11) Pair coverage supports aggregation", fillcolor="#A5D6A7"];
  "prop:experiment-coverage-lower-bound" [label="(12) Experiment coverage lower bound", fillcolor="#A5D6A7"];
  "prop:experiment-overlap-correction" [label="(13) Overlap subtracts duplicated comparisons", fillcolor="#A5D6A7"];
  "prop:flat-projection-loss" [label="(14) Flat projections lose comparison context", fillcolor="#A5D6A7"];
  "prop:marker-panel-information-bound" [label="(15) Binary marker-panel information bound", fillcolor="#A5D6A7"];
  "def:comparison-family-marker" -> "cor:pairwise-reporting-reusable";
  "def:comparison-family-marker" -> "prop:cell-type-marker-recurrence";
  "def:comparison-family-marker" -> "prop:comparison-family-monotonicity";
  "def:comparison-family-marker" -> "prop:hierarchical-marker-inclusion";
  "def:comparison-family-marker" -> "prop:one-vs-background-decomposition";
  "def:comparison-family-marker" -> "prop:type-state-scope-inclusion";
  "def:comparison-family-marker" -> "thm:pairwise-recurrence-marker";
  "def:marker-family-axioms" -> "def:comparison-family-marker";
  "def:marker-family-axioms" -> "thm:marker-axiom-representation";
  "prop:pair-coverage-aggregation" -> "prop:experiment-coverage-lower-bound";
  legend [shape=plaintext, margin=0, label=<<table border="0" cellborder="0" cellspacing="3" cellpadding="1"><tr><td align="left" colspan="2"><font point-size="10"><b>legend</b></font></td></tr><tr><td align="left" border="1" color="#777777" bgcolor="#90CAF9" cellpadding="5">definition</td></tr><tr><td align="left" border="1" color="#777777" bgcolor="#66BB6A" cellpadding="5">theorem</td></tr><tr><td align="left" border="1" color="#777777" bgcolor="#A5D6A7" cellpadding="5">proposition</td></tr><tr><td align="left" border="1" color="#777777" bgcolor="#BEE3BF" cellpadding="5">corollary</td></tr></table>>];
}

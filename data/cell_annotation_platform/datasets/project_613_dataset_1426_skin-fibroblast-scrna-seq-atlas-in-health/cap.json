"ontologyTermId": null, "ontologyTerm": null, "rationale": null, "rationaleDois": null, "markerGenes": null, "canonicalMarkerGenes": null, "synonyms": null, "categoryFullName": null, "categoryOntologyTermExists": null, "categoryOntologyTermId": null, "categoryOntologyTerm": null, "ontologyAssessment": null}, {"name": "Eczema", "count": 2807, "color": "#db57b2", "fullName": null, "ontologyTermExists": null, "ontologyTermId": null, "ontologyTerm": null, "rationale": null, "rationaleDois": null, "markerGenes": null, "canonicalMarkerGenes": null, "synonyms": null, "categoryFullName": null, "categoryOntologyTermExists": null, "categoryOntologyTermId": null, "categoryOntologyTerm": null, "ontologyAssessment": null}]}, {"name": "cell_type", "description": "Aim to harmonise skin fibroblast labels across studies in both health and disease. This specific dataset includes only healthy/non-lesional cells.", "annotationMethod": "manual", "algorithmName": "NA", "algorithmVersion": "NA", "algorithmRepoUrl": "NA", "referenceLocation": "NA", "referenceDescription": "NA", "mode": "cell-labels", "status": "parsed", "labelCount": null, "labels": [{"name": "F2: Universal", "count": 58378, "color": "#db5f57", "fullName": "Universal fibroblast", "ontologyTermExists": null, "ontologyTermId": "CL:0000057", "ontologyTerm": "fibroblast", "rationale": "We named this population based in highest expression of CD34, PI16, and MFAP5, which are reported as UniversalPi16+ fibroblast markers in Buechler et al. This population also had the highest expression of LGR5, in agreement with a potential stem state reported by Buechler.\n\nUniversal fibroblasts have been reported in the stroma in skin (see McCartney et al. 2024 (in DOI links)). Our cross-tissue analysis also supported these fibroblasts as Universal. However, we note that F2/3: Perivascular fibroblasts also have universal features.", "rationaleDois": ["10.1038/s41586-021-03549-5.", "10.12688/f1000research.143511.1."], "markerGenes": ["CD34", "PI16", "MFAP5", "DPP4", "PCOLCE2", "LGR5", "SLPI", "CD70", "CTHRC1"], "canonicalMarkerGenes": ["CD34", "PI16", "MFAP5"], "synonyms": ["Steady-state like fibroblast", "Reticular fibroblast"], "categoryFullName": "stromal cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000499", "categoryOntologyTerm": "stromal cell", "ontologyAssessment": null}, {"name": "F1: Superficial", "count": 24421, "color": "#dbb757", "fullName": "Superficial fibroblast", "ontologyTermExists": null, "ontologyTermId": "CL:0002620", "ontologyTerm": "skin fibroblast", "rationale": "LOCATION:\nAdjacent to epidermis.\n\nGENE EXPRESSION:\nSuperficial dermal collagens (COL18, COL23) and WNT inhibitors (WIF1, RSPO1).\n\nSKIN-SPECIFIC:\nPapillary fibroblasts.\n\nCROSS-TISSUE INSIGHTS:\nVariable across tissues, which may reflect a role in imprinting epithelial identity. Highest similarity to nasal mucosa epithelia, which may reflect increased similarity of nasal mucosa epithelia to skin relative to other tissues.", "rationaleDois": null, "markerGenes": ["APCDD1", "COL18A1", "COL23A1", "COL13A1", "COMP", "NKD2", "RSPO1", "AXIN2"], "canonicalMarkerGenes": ["APCDD1", "COL18A1", "COL23A1"], "synonyms": ["Papillary fibroblast"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}, {"name": "F3: FRC-like", "count": 17576, "color": "#a7db57", "fullName": "CCL19+ Fibroblast reticular-like cell", "ontologyTermExists": null, "ontologyTermId": "CL:0009101", "ontologyTerm": "fibroblastic reticular cell", "rationale": "LOCATION:\nSuperficial perivascular region in immune niche (lesser extent immune niche adjacent to hair follicles).\n\nGENE EXPRESSION:\nSimilar gene expression to FRCs (specialised fibroblast populations in lymphoid tissue), particularly to T zone reticular cells (CCL19, CH25H, IL33, TNFSF13B, IL33).\n\nCROSS-TISSUE INSIGHTS\nObserved in different tissues. Similar to intestinal T zone reticular cells that are enriched in IBD.", "rationaleDois": null, "markerGenes": ["CCL19", "CD74", "CH25H", "TNFSF13B", "IL33", "IRF8", "IL15", "VCAM1", "HLA-DRB1", "HLA-DRA"], "canonicalMarkerGenes": ["CCL19", "CD74", "CH25H", "VCAM1"], "synonyms": ["unknown"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}, {"name": "F4: DS_DPEP1+", "count": 17809, "color": "#57db5f", "fullName": "Dermal sheath_DPEP1+ (hair-follicle associated)", "ontologyTermExists": null, "ontologyTermId": "CL:0002620", "ontologyTerm": "skin fibroblast", "rationale": "LOCATION:\nAround hair follicles.\n\nGENE EXPRESSION:\nDermal sheath markers well characterised (Ahler at al., Ganier et al).", "rationaleDois": null, "markerGenes": ["DPEP1", "MYL4", "MEF2C", "COL11A1"], "canonicalMarkerGenes": ["DPEP1", "MYL4", "COL11A1"], "synonyms": ["unknown"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}, {"name": "F4: TNN+COCH+", "count": 3121, "color": "#57dbb7", "fullName": "Hair-follicle associated (TNN+COCH+)", "ontologyTermExists": null, "ontologyTermId": "CL:0002620", "ontologyTerm": "skin fibroblast", "rationale": "LOCATION:\nIsthmus / mid hair shaft.\n\nGENE EXPRESSION:\nUniquely enriched in genes associated with tendon-forming fibroblasts (MKX, TNMD).", "rationaleDois": null, "markerGenes": ["TNN", "COCH", "TNMD", "MKX", "NRG3", "SLITRK6"], "canonicalMarkerGenes": ["unknown"], "synonyms": ["unknown"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}, {"name": "F2/3: Perivascular", "count": 27418, "color": "#57a7db", "fullName": "Perivascular (universal)", "ontologyTermExists": null, "ontologyTermId": "CL:0002620", "ontologyTerm": "skin fibroblast", "rationale": "LOCATION:\nEnriched in superficial and deep perivascular regions (F3 was only in superficial perivascular regions).\n\nGENE EXPRESSION:\nHighest expression of CXCL12, but CXCL12 expression is non-specific. Zhu et al. describe CXCL12+ fibroblasts as distinct to Universal fibroblasts. \n\nA subset expressed PPARG.\n\nThis population also expressed F2: Universal markers. We speculate that it may represent a universal fibroblast population, especially as 1) it expressed F2 markers, 2) in neurofibroma, we observed F2/3: Perivascular fibroblasts, and trajectory inference suggested this population gave rise to F5: Schwann-like fibroblasts.\n\nSKIN-SPECIFIC NAME:\nReticular pre-adipocyte.\n\nCROSS-TISSUE INSIGHTS:\nSimilar gene expression was seen across tissues. In lung, this population was called Lipofibroblast. In gut, this population most resembled mLN stroma, which was reported to be an adipocyte stroma like population. In both cases, and consistent with skin data, there is a pre-adipocyte enrichment reported.", "rationaleDois": ["10.1016/j.jid.2023.09.288", "10.1038/s41586-021-03852-1", "10.1038/s41591-023-02327-2"], "markerGenes": ["CXCL12", "APOE", "EFEMP1", "APOC1", "C7", "PLA2G2A", "PPARG", "MYOC", "GDF10"], "canonicalMarkerGenes": ["unknown"], "synonyms": ["unknown"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}, {"name": "F5: NGFR+", "count": 2614, "color": "#5f57db", "fullName": "Schwann-like fibroblast (NGFR+)", "ontologyTermExists": null, "ontologyTermId": "CL:0002620", "ontologyTerm": "skin fibroblast", "rationale": "LOCATION:\nNerve-associated (co-localize with Schwann cells).\n\nGENE EXPRESSION:\nShared Schwann markers (SCN7A, ITGA6, NGFR) plus unique markers not highly expressed in Schwann (PDGFRA, DCN, TENM2).\n\nCROSS-TISSUE INSIGHTS:\nConsistent with \"Nerve-associated\" fibroblasts annotated in Human Lung Cell Atlas in a cross-tissue integration.", "rationaleDois": null, "markerGenes": ["NGFR", "ITGA6", "SCN7A", "CDH19", "CLDN1", "SFRP4", "TENM2"], "canonicalMarkerGenes": ["unknown"], "synonyms": ["Nerve-associated fibroblast"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}, {"name": "F4: DP_HHIP+", "count": 908, "color": "#b757db", "fullName": "Hair-follicle associated (dermal papilla)", "ontologyTermExists": null, "ontologyTermId": "CL:0000346", "ontologyTerm": "hair follicle dermal papilla cell", "rationale": "LOCATION:\nNot visualized on Xenium.\n\nGENE EXPRESSION:\nUniquely expressed high levels of certain dermal papilla markers (CORIN, BMP7, LEF1, WNT5A). We note that some of these markers have been reported for anagen dermal papilla, and thus we do not exclude that this represents an anagen dermal papilla population specifically.", "rationaleDois": null, "markerGenes": ["CORIN", "HHIP", "BMP7", "WNT5A", "LEF1"], "canonicalMarkerGenes": ["CORIN", "BMP7", "LEF1", "WNT5A"], "synonyms": ["unknown"], "categoryFullName": "connective tissue cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0002320", "categoryOntologyTerm": "connective tissue cell", "ontologyAssessment": null}, {"name": "F5: RAMP1+", "count": 1301, "color": "#db57a7", "fullName": "Schwann-like fibroblast (RAMP1+)", "ontologyTermExists": null, "ontologyTermId": "CL:0002620", "ontologyTerm": "skin fibroblast", "rationale": "LOCATION:\nEnriched near eccrine glands.\n\nGENE EXPRESSION:\nShared markers with Nerve-associated F5: NGFR+ (SCN7A, FMO2, FGFBP2, OLFML2A, PEAR1), including Schwann marker SCN7A. Had highest expression of RAMP1 and CALCRL, which form the receptor complex for the neuropeptide CGRP, suggesting an interface with nerves.\n\nThe function of this population is unclear. In neurofibroma, both F5: NGFR+ and F5: RAMP1+ (as well as F2/3: Perivascular) fibroblast populations were observed.\n\nCROSS-TISSUE INSIGHTS:\nNot observed, unlike F5: NGFR+", "rationaleDois": null, "markerGenes": ["RAMP1", "RELN", "PLEKHA6", "IGFBP2", "FGFBP2", "SCN7A"], "canonicalMarkerGenes": ["unknown"], "synonyms": ["unknown"], "categoryFullName": "fibroblast", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000057", "categoryOntologyTerm": "fibroblast", "ontologyAssessment": null}]}, {"name": "disease_category", "description": null, "annotationMethod": null, "algorithmName": null, "algorithmVersion": null, "algorithmRepoUrl": null, "referenceLocation": null, "referenceDescription": null, "mode": "unused", "status": "parsed", "labelCount": null, "labels": [{"name": "Nonlesional", "count": 153546, "color": "#db5f57", "fullName": null, "ontologyTermExists": null, "ontologyTermId": null, "ontologyTerm": null, "rationale": null, "rationaleDois": null, "markerGenes": null, "canonicalMarkerGenes": null, "synonyms": null, "categoryFullName": null, "categoryOntologyTermExists": null, "categoryOntologyTermId": null, "categoryOntologyTerm": null, "ontologyAssessment": null}]}]}
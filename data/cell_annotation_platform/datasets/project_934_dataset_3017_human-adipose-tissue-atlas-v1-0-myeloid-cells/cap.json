ode": "unused", "status": "unparsed", "labelCount": 3, "order": null, "labels": []}, {"name": "batch_id", "description": null, "annotationMethod": null, "algorithmName": null, "algorithmVersion": null, "algorithmRepoUrl": null, "referenceLocation": null, "referenceDescription": null, "mode": "unused", "status": "unparsed", "labelCount": 26, "order": null, "labels": []}, {"name": "lvl2_cell_types", "description": "Level 2 cell type labels (represents broad clusters most studies tend to identify).", "annotationMethod": "manual", "algorithmName": "NA", "algorithmVersion": "NA", "algorithmRepoUrl": "NA", "referenceLocation": "NA", "referenceDescription": "NA", "mode": "cell-labels", "status": "parsed", "labelCount": 3, "order": null, "labels": [{"name": "Mast cells", "count": 9779, "color": "#db5f57", "fullName": "mast cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000097", "ontologyTerm": "mast cell", "rationale": "KIT (CD117) is a receptor tyrosine kinase broadly used to identify mast cells across tissues. CPA3 (carboxypeptidase A3) is a mast cell-specific serine protease stored in secretory granules. Together these markers reliably identify mast cells and distinguish them from other immune cell populations.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["KIT", "CPA3"], "canonicalMarkerGenes": ["KIT", "CPA3"], "synonyms": ["tissue basophil", "mastocyte", "histaminocyte", "labrocyte"], "categoryFullName": "myeloid cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000763", "categoryOntologyTerm": "myeloid cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "Dendritic cells", "count": 4737, "color": "#57db5f", "fullName": "dendritic cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000451", "ontologyTerm": "dendritic cell", "rationale": "FLT3 is a pan-dendritic cell marker expressed across DC progenitors and mature DC subsets. Together with clustering context, FLT3 defines the dendritic cell compartment encompassing cDC1, cDC2B, activated DC, pDC, and proliferating DC subtypes.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["FLT3"], "canonicalMarkerGenes": ["FLT3"], "synonyms": ["interdigitating cell", "veiled cell"], "categoryFullName": "leukocyte", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000738", "categoryOntologyTerm": "leukocyte", "ontologyAssessment": null, "averageConfScore": null}, {"name": "Macrophages & Monocytes", "count": 167177, "color": "#5f57db", "fullName": "myeloid leukocyte", "ontologyTermExists": true, "ontologyTermId": "CL:0000766", "ontologyTerm": "myeloid leukocyte", "rationale": "MRC1 (CD206) and F13A1 are broadly expressed across tissue-resident macrophage populations, while FCN1 (ficolin-1) shows enriched expression in monocyte populations. Together these markers define the macrophage and monocyte compartment encompassing LAMs, PVMs, inflammatory macrophages, proliferating macrophages, classical monocytes, non-classical monocytes, and CD14\u207aS100A8/9\u207a monocytes.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["MRC1", "F13A1", "FCN1"], "canonicalMarkerGenes": ["MRC1", "F13A1", "FCN1"], "synonyms": ["unknown"], "categoryFullName": "myeloid leukocyte", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000766", "categoryOntologyTerm": "myeloid leukocyte", "ontologyAssessment": null, "averageConfScore": null}]}, {"name": "lvl3_cell_types", "description": "Level 3 cell type labels (most fine-grained).", "annotationMethod": "manual", "algorithmName": "NA", "algorithmVersion": "NA", "algorithmRepoUrl": "NA", "referenceLocation": "NA", "referenceDescription": "NA", "mode": "cell-labels", "status": "parsed", "labelCount": 14, "order": null, "labels": [{"name": "Mast cells", "count": 9779, "color": "#db5f57", "fullName": "mast cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000097", "ontologyTerm": "mast cell", "rationale": "KIT (CD117) is a receptor tyrosine kinase broadly used to identify mast cells across tissues. CPA3 (carboxypeptidase A3) is a mast cell-specific serine protease stored in secretory granules. Together these markers reliably identify mast cells and distinguish them from other immune cell populations.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["KIT", "CPA3"], "canonicalMarkerGenes": ["KIT", "CPA3"], "synonyms": ["tissue basophil", "mastocyte", "histaminocyte", "labrocyte"], "categoryFullName": "myeloid cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000763", "categoryOntologyTerm": "myeloid cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "cDC2B", "count": 2960, "color": "#db9757", "fullName": "dendritic cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000451", "ontologyTerm": "dendritic cell", "rationale": "FLT3 is a general dendritic cell marker expressed across DC progenitors and mature DC subsets. FCER1A (high-affinity IgE receptor), CD1C, CLEC10A, and IRF4 show enriched expression in cDC2s specifically, with IRF4 being a transcription factor involved in cDC2 differentiation and function. Together these markers identify cDC2B and distinguish them from cDC1 and other dendritic cell subsets.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["FLT3", "FCER1A", "CD1C", "CLEC10A", "IRF4"], "canonicalMarkerGenes": ["FLT3", "FCER1A", "CD1C", "CLEC10A", "IRF4"], "synonyms": ["interdigitating cell", "veiled cell"], "categoryFullName": "dendritic cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000451", "categoryOntologyTerm": "dendritic cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "CD14\u207aCD16\u207a Monocytes", "count": 2316, "color": "#dbd057", "fullName": "CD14-positive, CD16-positive monocyte", "ontologyTermExists": true, "ontologyTermId": "CL:0002397", "ontologyTerm": "CD14-positive, CD16-positive monocyte", "rationale": "FCN1 (ficolin-1) is a pattern recognition molecule with enriched expression in monocytes broadly. FCGR3A (CD16), HES4, LST1, and DGKG show enriched expression in CD14\u207aCD16\u207a non-classical monocytes specifically, with FCGR3A being the defining surface marker of this subset. Together these markers identify the non-classical monocyte subset and distinguish them from classical monocyte populations.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["FCN1", "FCGR3A", "HES4", "LST1", "DGKG"], "canonicalMarkerGenes": ["FCN1", "FCGR3A", "HES4", "LST1", "DGKG"], "synonyms": ["CD16+ monocyte"], "categoryFullName": "monocyte", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000576", "categoryOntologyTerm": "monocyte", "ontologyAssessment": null, "averageConfScore": null}, {"name": "pDC", "count": 237, "color": "#addb57", "fullName": "plasmacytoid dendritic cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000784", "ontologyTerm": "plasmacytoid dendritic cell", "rationale": "CLEC4C (BDCA-2) and LILRA4 (BDCA-4) are surface markers with enriched expression in plasmacytoid dendritic cells. IL3RA (CD123) further supports pDC identity. TCF4, IRF7, and IRF8 are transcription factors involved in pDC specification and function, with IRF7 playing a role in type I interferon production characteristic of this population. NRP1 (neuropilin-1) shows enriched expression in pDCs across tissues. Together these markers identify plasmacytoid dendritic cells and distinguish them from conventional DC subsets.", "rationaleDois": ["10.3390/cancers14143545"], "markerGenes": ["CLEC4C", "LILRA4", "IL3RA", "NRP1", "TCF4", "IRF7", "IRF8"], "canonicalMarkerGenes": ["CLEC4C", "LILRA4", "IL3RA", "NRP1", "TCF4", "IRF7", "IRF8"], "synonyms": ["lymphoid dendritic cell", "plasmacytoid T cell", "IPC", "plasmacytoid monocyte", "pDC", "DC2", "interferon-producing cell"], "categoryFullName": "dendritic cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000451", "categoryOntologyTerm": "dendritic cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "cDC1", "count": 752, "color": "#75db57", "fullName": "conventional dendritic cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000990", "ontologyTerm": "conventional dendritic cell", "rationale": "FLT3 is a general dendritic cell marker expressed across DC progenitors and mature DC subsets. XCR1, CLEC9A (DNGR-1), CADM1, and DPP4 show enriched expression in cDC1s specifically, with XCR1 and CLEC9A being well-characterized surface markers of this subset involved in cross-presentation of antigens. Together these markers identify cDC1s and distinguish them from cDC2 and other dendritic cell subsets.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["FLT3", "XCR1", "CLEC9A", "CADM1", "DPP4"], "canonicalMarkerGenes": ["FLT3", "XCR1", "CLEC9A", "CADM1", "DPP4"], "synonyms": ["cDC", "DC1", "interdigitating cell", "dendritic reticular cell", "type 1 DC", "veiled cell"], "categoryFullName": "dendritic cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000451", "categoryOntologyTerm": "dendritic cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "CD14\u207aCD16\u207b Monocytes", "count": 5355, "color": "#57db72", "fullName": "CD14-positive, CD16-negative classical monocyte", "ontologyTermExists": true, "ontologyTermId": "CL:0002057", "ontologyTerm": "CD14-positive, CD16-negative classical monocyte", "rationale": "FCN1 (ficolin-1) is a pattern recognition molecule with enriched expression in classical monocytes. FCER1A, TXNIP (thioredoxin interacting protein), and FCAR (Fc alpha receptor, CD89) show enriched expression in CD14\u207aCD16\u207b classical monocytes specifically. Together these markers identify the classical monocyte subset and distinguish them from non-classical and intermediate monocyte populations.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["FCN1", "FCER1A", "TXNIP", "FCAR"], "canonicalMarkerGenes": ["FCN1", "FCER1A", "TXNIP", "FCAR"], "synonyms": ["CD16-negative monocyte", "CD16- monocyte"], "categoryFullName": "monocyte", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000576", "categoryOntologyTerm": "monocyte", "ontologyAssessment": null, "averageConfScore": null}, {"name": "Activated DCs", "count": 725, "color": "#57dbaa", "fullName": "dendritic cell", "ontologyTermExists": true, "ontologyTermId": "CL:0000451", "ontologyTerm": "dendritic cell", "rationale": "FLT3 is a general dendritic cell marker expressed across DC progenitors and mature DC subsets. CCR7, FSCN1, CCL22, and LAMP3 show enriched expression in activated/migratory DCs, reflecting an activation and maturation state rather than a fixed DC subset identity. Together these markers identify a transcriptionally distinct activated DC population and distinguish them from resident cDC1 and cDC2 subsets.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["FLT3", "CCR7", "FSCN1", "CCL22", "LAMP3"], "canonicalMarkerGenes": ["FLT3", "CCR7", "FSCN1", "CCL22", "LAMP3"], "synonyms": ["interdigitating cell", "veiled cell"], "categoryFullName": "dendritic cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000451", "categoryOntologyTerm": "dendritic cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "CD14\u207aS100A8/9\u207a Monocytes", "count": 1470, "color": "#57d3db", "fullName": "monocyte", "ontologyTermExists": true, "ontologyTermId": "CL:0000576", "ontologyTerm": "monocyte", "rationale": "FCN1 (ficolin-1) is a pattern recognition molecule with enriched expression in monocytes broadly. S100A8 and S100A9 (calprotectin subunits) show highly enriched expression in this specific subset, marking an inflammatory monocyte state associated with innate immune activation. Together these markers identify a transcriptionally distinct CD14\u207aS100A8/9\u207a monocyte population and distinguish them from classical and non-classical monocyte subsets.", "rationaleDois": ["10.2119/molmed.2011.00144"], "markerGenes": ["FCN1", "S100A8", "S100A9"], "canonicalMarkerGenes": ["FCN1", "S100A8", "S100A9"], "synonyms": ["inflammatory monocyte"], "categoryFullName": "monocyte", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000576", "categoryOntologyTerm": "monocyte", "ontologyAssessment": null, "averageConfScore": null}, {"name": "Neutrophils", "count": 252, "color": "#579bdb", "fullName": "neutrophil", "ontologyTermExists": true, "ontologyTermId": "CL:0000775", "ontologyTerm": "neutrophil", "rationale": "S100A12 and S100A9 are calcium-binding proteins highly expressed in neutrophils and reflect their inflammatory state. CSF3R (CD114, G-CSF receptor) is a surface receptor involved in neutrophil development and survival. CXCR2 is a chemokine receptor mediating neutrophil recruitment to sites of inflammation, and FCGR3B (CD16b) is a neutrophil-specific isoform of CD16 distinguishing neutrophils from NK cells and monocytes that express FCGR3A. Together these markers reliably identify neutrophils and distinguish them from other myeloid cell populations.", "rationaleDois": ["10.1038/s42255-025-01296-9", "10.1016/s1074-7613(01)00150-9", "10.1097/MOH.0000000000000476"], "markerGenes": ["S100A12", "S100A9", "CSF3R", "CXCR2", "FCGR3B"], "canonicalMarkerGenes": ["S100A12", "S100A9", "CSF3R", "CXCR2", "FCGR3B"], "synonyms": ["PMN", "polymorphonuclear leucocyte", "polynuclear neutrophilic leukocyte", "neutrophil leukocyte", "polymorphonuclear leukocyte"], "categoryFullName": "myeloid cell", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000763", "categoryOntologyTerm": "myeloid cell", "ontologyAssessment": null, "averageConfScore": null}, {"name": "PVMs", "count": 135955, "color": "#5762db", "fullName": "perivascular macrophage", "ontologyTermExists": true, "ontologyTermId": "CL:0000881", "ontologyTerm": "perivascular macrophage", "rationale": "MRC1 (CD206) and F13A1 are general macrophage markers broadly expressed across tissue-resident macrophage populations. LYVE1, SELENOP (selenoprotein P), and C1QA show enriched expression in perivascular macrophages specifically, with LYVE1 marking macrophages associated with the perivascular niche. Together these markers identify perivascular macrophages (PVMs) and distinguish them from other macrophage subpopulations including LAMs.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["MRC1", "F13A1", "LYVE1", "SELENOP", "C1QA"], "canonicalMarkerGenes": ["MRC1", "F13A1", "LYVE1", "SELENOP", "C1QA"], "synonyms": ["pvM\u03a6"], "categoryFullName": "macrophage", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000235", "categoryOntologyTerm": "macrophage", "ontologyAssessment": null, "averageConfScore": null}, {"name": "LAMs", "count": 17959, "color": "#8557db", "fullName": "lipid-associated macrophage", "ontologyTermExists": true, "ontologyTermId": "CL:4033086", "ontologyTerm": "lipid-associated macrophage", "rationale": "MRC1 (CD206) and F13A1 are general macrophage markers broadly expressed across tissue-resident macrophage populations. CD9, TREM2, and LPL (lipoprotein lipase) show enriched expression in lipid-associated macrophages specifically, with TREM2 being a receptor involved in lipid sensing and metabolism. Together these markers identify lipid-associated macrophages (LAMs) and distinguish them from other macrophage subpopulations.", "rationaleDois": ["10.1038/s42255-025-01296-9"], "markerGenes": ["MRC1", "F13A1", "CD9", "TREM2", "LPL"], "canonicalMarkerGenes": ["MRC1", "F13A1", "CD9", "TREM2", "LPL"], "synonyms": ["LAM"], "categoryFullName": "macrophage", "categoryOntologyTermExists": true, "categoryOntologyTermId": "CL:0000235", "categoryOntologyTerm": "macrophage", "ontologyAssessment": null, "averageConfScore": null}, {"name": "Proliferating macrophages", "count": 2102, "color": "#bd57db", "fullName": "cycling macrophage", "